# Supabase (Settings → API do seu projeto)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Só no servidor. Nunca exponha no navegador.
SUPABASE_SERVICE_ROLE_KEY=

# URL pública do site (sitemap, links nos e-mails, JobPosting)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# IA — sem chave, a Lia e o match usam o modo heurístico local
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Embeddings (opcional, qualquer API compatível com OpenAI /v1/embeddings)
EMBEDDINGS_API_URL=
EMBEDDINGS_API_KEY=
EMBEDDINGS_MODEL=

# E-mail transacional (Resend). Sem chave, os e-mails ficam só registrados em email_outbox.
RESEND_API_KEY=
EMAIL_FROM="VagaLoop <nao-responda@vagaloop.com.br>"
